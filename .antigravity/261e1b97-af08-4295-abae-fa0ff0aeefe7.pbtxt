steps {
  type: CORTEX_STEP_TYPE_USER_INPUT
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1791898521
      nanos: 926805641
    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    source_trajectory_step_info {
      trajectory_id: "261e1b97-af08-4295-abae-fa0ff0aeefe7"
      step_index: 1
      cascade_id: "261e1b97-af08-4295-abae-fa0ff0aeefe7"
    }
