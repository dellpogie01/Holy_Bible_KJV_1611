              text: "\342\224\214\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\226\274\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\220"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\342\224\202                    Data & Storage Layer                \342\224\202"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\342\224\202       (Room Database + FTS4 Virtual Table + DAO)       \342\224\202"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\342\224\224\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\230"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Data Model & Entities**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `BookEntity`: id, name, testament (\"OT\" or \"NT\"), totalChapters, bookOrder"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `VerseEntity`: id, bookId, chapter, verseNum, text"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `BookmarkEntity`: id, bookId, bookName, chapter, verseNum, text, timestamp"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `ReadingPositionEntity`: id, bookId, bookName, chapter, verseNum, timestamp"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Key Modules to Implement**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  1. `Database & Seeding`: `BibleDatabase.kt`, `BibleDao.kt`, `BookEntity.kt`, `VerseEntity.kt`, `BookmarkEntity.kt`, `ReadingPositionEntity.kt`. Preload all 66 books and essential verses (Genesis, Psalms, Gospels, Revelation, etc., plus full complete Bible generation utility or robust seed dataset of KJV texts)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  2. `Repositories`: `BibleRepository.kt` managing local queries, FTS search, bookmarks, and reading progress."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  3. `ViewModels`: `BibleViewModel.kt` handling UI state, current book/chapter navigation, search query flow, and bookmarks."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  4. `UI Composables`:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     - `SplashScreen.kt`: Reverent deep navy & gold cross launch animation."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     - `HomeScreen.kt`: Continue reading, Verse of the Day, OT/New Testament cards, quick search."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     - `BooksScreen.kt`: Tabbed or grouped Old/New Testament book picker."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     - `ChapterScreen.kt`: Chapter reader with adjustable font size, verse tapping for copy/share/bookmark."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     - `SearchScreen.kt`: Offline instant keyword & reference search with highlighted terms."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     - `BookmarksScreen.kt`: List of saved verses."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "     - `BottomNav.kt`: Clean navigation bar."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///.aistudio/artifacts/brain/261e1b97-af08-4295-abae-fa0ff0aeefe7/implementation_plan.md"
